<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée de l'application (profils chiffrés, progression, session de
     lecture) n'est sauvegardée dans le cloud ni transférée vers un autre appareil.
     De toute façon, la clé Keystore qui chiffre les profils ne quitte pas l'appareil. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
