<resources>
    <color name="brand">#FF0B1A2E</color>
    <color name="accent">#FF29B6F6</color>

    <!--
        Thème de l'application, basé sur AppCompat : la boîte de dialogue Cast (choix de l'appareil)
        utilise le thème de l'écran et plante si colorPrimary n'est pas défini.
        L'interface elle-même est en Jetpack Compose (Material 3) et n'utilise pas ces couleurs.
    -->
    <style name="Theme.IPTV" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
